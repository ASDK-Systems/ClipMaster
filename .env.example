# =============================================================================
# YTAutomation — Environment Variables
# Copy this to .env and fill in your values
# =============================================================================

# --- OpenAI (Whisper STT only) ---
OPENAI_API_KEY=sk-your-openai-api-key

# --- Ollama (local AI for viral clip detection) ---
# Make sure Ollama is running: ollama serve
# Pull a model first: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4

# --- Gemini (cloud AI for viral clip detection) ---
# If GEMINI_API_KEY is set and USE_GEMINI=true, Gemini is used instead of Ollama.
# Get a key at https://aistudio.google.com/apikey
USE_GEMINI=true
GEMINI_API_KEY=your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ytautomation

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Object Storage (S3-compatible: AWS S3 or Cloudflare R2) ---
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=ytautomation

# --- Whop (Monetization) ---
WHOP_API_KEY=your-whop-api-key
WHOP_WEBHOOK_SECRET=your-webhook-secret

# --- YouTube Data API (Publishing) ---
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# --- App Settings ---
MAX_VIDEO_DURATION_MINUTES=180
MAX_CLIPS_PER_VIDEO=10
DOWNLOADS_DIR=./downloads
OUTPUT_DIR=./output

# --- FFmpeg ---
# Uncomment if ffmpeg is not on your PATH
# FFMPEG_LOCATION=/usr/local/bin/ffmpeg
